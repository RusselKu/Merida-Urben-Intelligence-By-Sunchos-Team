# ==========================================================
# Mérida Urban Intelligence - Environment Configuration Template
# ==========================================================
# Copy this file to .env or .env.local and fill in your values.
# NEVER commit .env to GitHub!

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- PostgreSQL / PostGIS Connection ---
# Direct connection string to Supabase PostgreSQL (Port 5432 or 6543)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password

# --- FastAPI Backend Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://merida-urban-intelligence.vercel.app

# --- Frontend Configuration ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
